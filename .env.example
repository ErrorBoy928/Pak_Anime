PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string
ADMIN_EMAIL=admin@pakanime.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!

# --- Database (Turso) ---
# Leave both blank for local development — the app falls back to a local
# SQLite file automatically. Fill these in for production (see README).
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# --- File storage (Cloudflare R2) ---
# Leave all four blank for local development — videos/posters save to the
# local uploads/ folder automatically. Fill these in for production.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
